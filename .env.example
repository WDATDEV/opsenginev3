DATABASE_URL=postgresql://opsengine:opsengine@localhost:55433/opsengine
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h
# Encrypts the connector keys saved in the database (Gmail, Warehance, Slack, Claude).
# Use a long random value in production. If it changes, the keys must be saved again in Settings.
SECRETS_KEY=
API_PORT=3011
WEB_ORIGIN=http://localhost:3010
API_UPSTREAM=http://localhost:3011
NEXT_PUBLIC_API_URL=http://localhost:3010/api
JOB_TOKEN=dev-job-token
WORKER_INTERVAL_MS=60000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Set it only if the sign-in address Google sees differs from the API's public address.
GOOGLE_REDIRECT_URI=
SEED_OWNER_EMAIL=owner@opsengine.local
SEED_OWNER_PASSWORD=OpsEngine!dev
